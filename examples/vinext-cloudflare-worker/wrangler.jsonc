{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "a2ui-vinext-example",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  }
}
