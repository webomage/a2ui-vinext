{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "w0m-web/openspec/SPEC-AUTHORING-STANDARD.md"
  ],
  "model": "mlx/gemma-4-12b-coder-fable5-composer2.5-4bit",
  "small_model": "mlx/gemma-4-e4b-it-4bit",
  "provider": {
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "w0m Local MLX (omlx / mlx_vlm)",
      "options": {
        "baseURL": "http://127.0.0.1:8888/v1"
      },
      "models": {
        "gemma-4-12b-coder-fable5-composer2.5-4bit": {
          "name": "Gemma 4 12B Coder Fable5 Composer 2.5 (4-bit)",
          "tool_call": false
        },
        "gemma-4-e4b-it-4bit": {
          "name": "Gemma 4 E4B IT (4-bit Small Offload \u2014 text-in/text-out only)",
          "tool_call": false
        }
      }
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": [
        "graphify-mcp",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "wom7md": {
      "type": "remote",
      "url": "http://127.0.0.1:3001/mcp",
      "enabled": true
    },
    "w0m-web": {
      "type": "remote",
      "url": "http://127.0.0.1:3007/mcp",
      "enabled": true
    }
  },
  "x_w0m_offload_policy": {
    "allowed_small_model_tasks": [
      "summarize",
      "classify",
      "rewrite",
      "draft",
      "commit-msg"
    ],
    "forbid_raw_mlx_tool_calls": true,
    "served_models": [
      "gemma-4-12b-coder-fable5-composer2.5-4bit",
      "gemma-4-e4b-it-4bit"
    ]
  }
}
