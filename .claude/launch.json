{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "just",
      "runtimeArgs": [
        "--justfile",
        "w0m-api/justfile",
        "--working-directory",
        "w0m-api",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "w0m-web",
        "--filter",
        "demo",
        "dev"
      ],
      "port": 4324
    },
    {
      "name": "cp",
      "runtimeExecutable": "just",
      "runtimeArgs": [
        "--justfile",
        "w0m-api/justfile",
        "--working-directory",
        "w0m-api",
        "dev-cp"
      ],
      "port": 4325
    },
    {
      "name": "docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4399",
        "--directory",
        "w0m-web/docs"
      ],
      "port": 4399
    }
  ]
}
